{
  "name": "gba",
  "version": "1.0.0",
  "type": "module",
  "description": "GBA emulator page for yoshik.xyz/gba — mGBA compiled to WebAssembly.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/copy-mgba.mjs && vite build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:local": "node scripts/dev-local.mjs --demo",
    "preview:local": "npm run build && node scripts/dev-local.mjs --demo --preview",
    "test:rom": "node scripts/make-test-rom.mjs",
    "qa": "node tests/qa/play.mjs && node tests/qa/offline.mjs && node tests/qa/perf.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoshik08/gba.git"
  },
  "license": "ISC",
  "devDependencies": {
    "playwright": "^1.64.1",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@thenick775/mgba-wasm": "^2.5.1",
    "animejs": "^4.5.0",
    "cookie": "^2.0.1",
    "google-auth-library": "^11.2.0",
    "googleapis": "^185.0.0",
    "gsap": "^3.15.0",
    "mongodb": "^7.7.0"
  }
