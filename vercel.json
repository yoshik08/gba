{
  "rewrites": [
    { "source": "/gba/api/:path*", "destination": "/api/:path*" },
    { "source": "/gba/:path*", "destination": "/dist/:path*" }
  ],
  "headers": [
    {
      "source": "/gba/play/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}